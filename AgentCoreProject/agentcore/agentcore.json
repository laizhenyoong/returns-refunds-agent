        },
        {
          "name": "GATEWAY_CLIENT_ID",
          "value": "12j3bf887j41lsede577e73i7h"
        },
        {
          "name": "GATEWAY_CLIENT_SECRET",
          "value": "REDACTED-DO-NOT-COMMIT-SECRETS-SET-LOCALLY-BEFORE-DEPLOY"
