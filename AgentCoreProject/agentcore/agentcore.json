          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-west-2:442829247723:function:workshop-data-lookup",
            "toolSchemaFile": "./tool_specs/data_lookup.json"
